# Required: the public origin where this Next.js app is served.
# Use http://localhost:3000 locally and your canonical HTTPS URL in production.
BETTER_AUTH_URL=http://localhost:3000

# Required: generate a unique secret with `openssl rand -base64 32`.
# Replace this placeholder; never commit a real secret.
BETTER_AUTH_SECRET=replace-me

# Runtime Neon/Postgres connection string shared by Next.js and FastAPI.
# Use Neon pooled endpoints for runtime services; keep it private.
DATABASE_URL=replace-with-your-neon-pooled-postgresql-connection-string

# Optional direct Neon endpoint used for schema migration jobs.
# Add the direct connection string as GitHub secret NEON_MIGRATION_DATABASE_URL.
NEON_MIGRATION_DATABASE_URL=replace-with-your-neon-direct-postgresql-connection-string

# Temporary local-only Admin bootstrap values; never commit real values.
ADMIN_PROVISIONING_EMAIL=owner@example.com
ADMIN_PROVISIONING_TOKEN_HASH=replace-with-a-sha256-hex-digest
ADMIN_PROVISIONING_TOKEN_EXPIRES_AT=replace-with-the-generated-expiry

# Public URL for the deployed FastAPI backend.
NEXT_PUBLIC_BACKEND_URL=https://barflow-rk55.onrender.com
